# Copy this to .env.local and fill in your values. .env.local is gitignored.

# ---------------- Python scripts ----------------
MSTR_BASE_URL=https://your-mstr-host/MicroStrategyLibrary/api
MSTR_USERNAME=your_service_account
MSTR_PASSWORD=your_password_here

# ---------------- React / Vite app ----------------
# Pre-fills the LoginPanel when the user selects the Ralph Lauren SBX
# environment. Leave blank to require manual entry. VITE_ prefix is required
# so Vite exposes the vars to the browser bundle.
VITE_MSTR_USERNAME=your_service_account
VITE_MSTR_PASSWORD=your_password_here

# ---------------- OpenAI ----------------
OPENAI_API_KEY=sk-...
